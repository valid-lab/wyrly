{
  // Wyrly DI — Deno workspace root (members under ./packages/*)
  "workspace": ["./packages/*", "./examples/*"],
  "exclude": ["**/npm/**"],
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.42.3",
    "@std/path": "jsr:@std/path@^1"
  },
  "compilerOptions": {
    "strict": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    // TC39 standard decorators (not legacy experimentalDecorators)
    "experimentalDecorators": false,
    "lib": ["deno.window", "esnext"]
  },
  "tasks": {
    "check": "deno check packages/core packages/express packages/hono packages/fresh packages/graphql packages/next examples/",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "test": "deno test -P packages/core && deno test -P packages/express && deno test packages/hono && deno test -P packages/fresh && deno test packages/graphql && deno test -P packages/next",
    "validate:example": "deno run -A examples/dependency-graph/main.ts",
    "example:basic-ddd": "deno task -f @wyrly-examples/basic-ddd start",
    "example:explicit-deps": "deno task -f @wyrly-examples/explicit-deps start",
    "example:provider-patterns": "deno task -f @wyrly-examples/provider-patterns start",
    "example:dependency-graph": "deno task -f @wyrly-examples/dependency-graph start",
    "example:hono-api": "deno task -f @wyrly-examples/hono-api start",
    "example:express-api": "deno task -f @wyrly-examples/express-api start",
    "example:graphql-request": "deno task -f @wyrly-examples/graphql-request start",
    "example:express-graphql": "deno task -f @wyrly-examples/express-graphql start",
    "example:fresh-routes": "deno task -f @wyrly-examples/fresh-routes start",
    "example:next-ddd": "deno task -f @wyrly-examples/next-ddd start",
    "examples:core": "deno task example:basic-ddd && deno task example:explicit-deps && deno task example:provider-patterns && deno task example:dependency-graph",
    "examples:adapters": "deno task example:hono-api && deno task example:graphql-request && deno task example:fresh-routes && deno task example:next-ddd && deno task example:express-api && deno task example:express-graphql",
    "examples": "deno task examples:core && deno task examples:adapters",
    "ci": "deno task fmt:check && deno task lint && deno task check && deno task test && deno task examples",
    "publish:dry-run": "deno publish --dry-run --allow-dirty --allow-slow-types --config packages/core/deno.json && deno publish --dry-run --allow-dirty --allow-slow-types --config packages/express/deno.json && deno publish --dry-run --allow-dirty --allow-slow-types --config packages/hono/deno.json && deno publish --dry-run --allow-dirty --allow-slow-types --config packages/fresh/deno.json && deno publish --dry-run --allow-dirty --allow-slow-types --config packages/graphql/deno.json && deno publish --dry-run --allow-dirty --allow-slow-types --config packages/next/deno.json",
    "publish:jsr": "deno publish --allow-slow-types --config packages/core/deno.json && deno publish --allow-slow-types --config packages/express/deno.json && deno publish --allow-slow-types --config packages/hono/deno.json && deno publish --allow-slow-types --config packages/fresh/deno.json && deno publish --allow-slow-types --config packages/graphql/deno.json && deno publish --allow-slow-types --config packages/next/deno.json",
    "build:npm": "deno run -A scripts/dnt/build.ts all",
    "build:npm:core": "deno run -A scripts/dnt/build.ts core",
    "publish:npm:dry-run": "cd packages/core/npm && npm publish --dry-run && cd ../../express/npm && npm publish --dry-run && cd ../../hono/npm && npm publish --dry-run && cd ../../graphql/npm && npm publish --dry-run && cd ../../next/npm && npm publish --dry-run",
    "publish:npm": "cd packages/core/npm && npm publish --access public && cd ../../express/npm && npm publish --access public && cd ../../hono/npm && npm publish --access public && cd ../../graphql/npm && npm publish --access public && cd ../../next/npm && npm publish --access public",
    "publish:npm:ci": "cd packages/core/npm && npm publish --provenance --access public && cd ../../express/npm && npm publish --provenance --access public && cd ../../hono/npm && npm publish --provenance --access public && cd ../../graphql/npm && npm publish --provenance --access public && cd ../../next/npm && npm publish --provenance --access public"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "include": ["packages/", "examples/", "scripts/dnt/", "deno.jsonc"]
  }
}
