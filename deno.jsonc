{
  // Wyrly DI — Deno workspace root (members under ./packages/*)
  "workspace": ["./packages/*", "./examples/*"],
  "exclude": ["**/npm/**", "compat/**", "benchmarks/**"],
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.42.3",
    "@std/path": "jsr:@std/path@^1",
    "lefthook": "npm:lefthook@2.1.6"
  },
  "compilerOptions": {
    "strict": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    // TC39 standard decorators (not legacy experimentalDecorators)
    "experimentalDecorators": false,
    "lib": ["deno.window", "esnext"]
  },
  "tasks": {
    "check": "deno check packages/core packages/express packages/hono packages/fresh packages/graphql packages/yoga packages/apollo packages/fastify packages/next examples/",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "pre-commit": "deno run -A lefthook run pre-commit",
    "pre-push": "deno run -A lefthook run pre-push --force",
    "setup:hooks": "bash scripts/setup-lefthook.sh",
    "lint": "deno lint && deno lint --rules-include=no-slow-types packages/",
    "doc:lint": "deno doc --lint packages/core/mod.ts && deno doc --lint packages/express/mod.ts && deno doc --lint packages/graphql/mod.ts && deno doc --lint packages/yoga/mod.ts && deno doc --lint packages/apollo/mod.ts && deno doc --lint packages/fastify/mod.ts && deno doc --lint packages/fresh/mod.ts",
    "test": "deno test -P packages/core && deno test -P packages/express && deno test packages/hono && deno test -P packages/fresh && deno test packages/graphql && deno test -P packages/yoga && deno test -P packages/apollo && deno test -P packages/fastify && deno test -P packages/next",
    "validate:example": "deno run -A examples/dependency-graph/main.ts",
    "example:basic-ddd": "deno task -f @wyrly-examples/basic-ddd start",
    "example:explicit-deps": "deno task -f @wyrly-examples/explicit-deps start",
    "example:provider-patterns": "deno task -f @wyrly-examples/provider-patterns start",
    "example:dependency-graph": "deno task -f @wyrly-examples/dependency-graph start",
    "example:hono-api": "deno task -f @wyrly-examples/hono-api start",
    "example:express-api": "deno task -f @wyrly-examples/express-api start",
    "example:graphql-request": "deno task -f @wyrly-examples/graphql-request start",
    "example:express-graphql": "deno task -f @wyrly-examples/express-graphql start",
    "example:yoga-graphql": "deno task -f @wyrly-examples/yoga-graphql start",
    "example:apollo-graphql": "deno task -f @wyrly-examples/apollo-graphql start",
    "example:apollo-express-graphql": "deno task -f @wyrly-examples/apollo-express-graphql start",
    "example:fastify-api": "deno task -f @wyrly-examples/fastify-api start",
    "example:fresh-routes": "deno task -f @wyrly-examples/fresh-routes start",
    "example:next-ddd": "deno task -f @wyrly-examples/next-ddd start",
    "examples:core": "deno task example:basic-ddd && deno task example:explicit-deps && deno task example:provider-patterns && deno task example:dependency-graph",
    "examples:adapters": "deno task example:hono-api && deno task example:graphql-request && deno task example:fresh-routes && deno task example:next-ddd && deno task example:express-api && deno task example:express-graphql && deno task example:fastify-api && deno task example:yoga-graphql && deno task example:apollo-graphql && deno task example:apollo-express-graphql",
    "examples": "deno task examples:core && deno task examples:adapters",
    "check:npm-readme": "deno run -A scripts/dnt/check-readmes.ts",
    "ci:deno": "deno task fmt:check && deno task check:npm-readme && deno task lint && deno task doc:lint && deno task check && deno task test && deno task examples",
    "ci": "deno task ci:deno && deno task publish:dry-run && deno task test:compat && deno task publish:npm:dry-run",
    "publish:dry-run": "deno publish --dry-run --allow-dirty --config packages/core/deno.json && deno publish --dry-run --allow-dirty --config packages/express/deno.json && deno publish --dry-run --allow-dirty --config packages/hono/deno.json && deno publish --dry-run --allow-dirty --config packages/fresh/deno.json && deno publish --dry-run --allow-dirty --config packages/graphql/deno.json && deno publish --dry-run --allow-dirty --config packages/yoga/deno.json && deno publish --dry-run --allow-dirty --config packages/apollo/deno.json && deno publish --dry-run --allow-dirty --config packages/fastify/deno.json && deno publish --dry-run --allow-dirty --config packages/next/deno.json",
    "publish:jsr": "deno publish --config packages/core/deno.json && deno publish --config packages/express/deno.json && deno publish --config packages/hono/deno.json && deno publish --config packages/fresh/deno.json && deno publish --config packages/graphql/deno.json && deno publish --config packages/yoga/deno.json && deno publish --config packages/apollo/deno.json && deno publish --config packages/fastify/deno.json && deno publish --config packages/next/deno.json",
    "publish:jsr:ci": "deno publish --allow-dirty --config packages/core/deno.json && deno publish --allow-dirty --config packages/express/deno.json && deno publish --allow-dirty --config packages/hono/deno.json && deno publish --allow-dirty --config packages/fresh/deno.json && deno publish --allow-dirty --config packages/graphql/deno.json && deno publish --allow-dirty --config packages/yoga/deno.json && deno publish --allow-dirty --config packages/apollo/deno.json && deno publish --allow-dirty --config packages/fastify/deno.json && deno publish --allow-dirty --config packages/next/deno.json",
    "build:npm": "deno run -A scripts/dnt/build.ts all",
    "build:npm:core": "deno run -A scripts/dnt/build.ts core",
    "build:npm:compat": "deno run -A scripts/dnt/build.ts all",
    "test:compat:bun": "cd compat/bun && bun install && bun test",
    "test:compat:node": "cd compat/node && npm install && npm test",
    "test:compat:workers": "cd compat/workers && npm install && npm test",
    "test:compat": "deno task build:npm:compat && deno task test:compat:node && deno task test:compat:bun && deno task test:compat:workers",
    "bench:di": "deno task build:npm:core && cd benchmarks/di && npm install && node --import tsx run.ts",
    "bench:di:lock": "deno task build:npm:core && cd benchmarks/di && npm install",
    "bench:di:ci": "deno task build:npm:core && cd benchmarks/di && npm ci && node --import tsx run.ts --json --adapter wyrly --suite resolution,cold_start,cold_start_resolution,request_scope",
    "bench:di:check": "deno run -A scripts/ci/check-di-bench.ts",
    "bench:di:report": "deno run -A scripts/ci/check-di-bench.ts --report",
    "bench:di:ci:full": "deno task bench:di:ci && deno task bench:di:check",
    "publish:npm:dry-run": "cd packages/core/npm && npm publish --dry-run && cd ../../express/npm && npm publish --dry-run && cd ../../hono/npm && npm publish --dry-run && cd ../../graphql/npm && npm publish --dry-run && cd ../../yoga/npm && npm publish --dry-run && cd ../../apollo/npm && npm publish --dry-run && cd ../../fastify/npm && npm publish --dry-run && cd ../../next/npm && npm publish --dry-run",
    "publish:npm": "cd packages/core/npm && npm publish --access public && cd ../../express/npm && npm publish --access public && cd ../../hono/npm && npm publish --access public && cd ../../graphql/npm && npm publish --access public && cd ../../yoga/npm && npm publish --access public && cd ../../apollo/npm && npm publish --access public && cd ../../fastify/npm && npm publish --access public && cd ../../next/npm && npm publish --access public",
    "publish:npm:ci": "cd packages/core/npm && npm publish --provenance --access public && cd ../../express/npm && npm publish --provenance --access public && cd ../../hono/npm && npm publish --provenance --access public && cd ../../graphql/npm && npm publish --provenance --access public && cd ../../yoga/npm && npm publish --provenance --access public && cd ../../apollo/npm && npm publish --provenance --access public && cd ../../fastify/npm && npm publish --provenance --access public && cd ../../next/npm && npm publish --provenance --access public"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "include": ["packages/", "examples/", "scripts/", "compat/", "benchmarks/", "deno.jsonc"]
  }
}
